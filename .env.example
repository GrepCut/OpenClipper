VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_PLATFORM=tauri

# Sentry crash reporting (production builds only; create a dedicated Open Clipper project)
VITE_SENTRY_DSN=

# GrepCut Studio URL for "Open in Studio" ephemeral import
VITE_STUDIO_URL=https://localhost:5173

# Desktop auto-updater (compile-time for Rust + generated tauri.updater.generated.json)
# Generate keys: npx tauri signer generate -w ~/.tauri/open-clipper.key
OPEN_CLIPPER_UPDATER_PUBKEY=
OPEN_CLIPPER_UPDATER_ENDPOINT="https://api.grepcut.com/api/app-updates/check/{{target}}/{{arch}}/{{current_version}}?channel=stable&product=open-clipper"
TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PATH=

# Integration OAuth debug logs (written to ../logs/integrations when running from open-clipper)
# INTEGRATION_LOGS_DIR=
# VITE_INTEGRATION_LOGS_ENABLED=true
