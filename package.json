{
  "name": "open-clipper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "cross-env VITE_APP_PLATFORM=tauri vite",
    "build": "npm run build:web",
    "build:web": "vite build && node scripts/prune-web-models.mjs",
    "build:tauri": "cross-env VITE_APP_PLATFORM=tauri vite build && node scripts/prune-tauri-dist.mjs",
    "test": "vitest run",
    "benchmark:run": "src-tauri\\target\\release\\open-clipper.exe --benchmark-run",
    "benchmark:run:dev": "tauri dev -- -- --benchmark-run",
    "benchmark:extract-miss-frames": "src-tauri\\target\\release\\open-clipper.exe --extract-miss-frames",
    "replay:arbiter": "tsx scripts/replay-arbiter.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:fast": "cross-env CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 CARGO_PROFILE_RELEASE_LTO=off CARGO_PROFILE_RELEASE_INCREMENTAL=true CARGO_PROFILE_RELEASE_OPT_LEVEL=2 CARGO_PROFILE_RELEASE_STRIP=none tauri build --no-bundle",
    "tauri:preview": "src-tauri\\target\\release\\open-clipper.exe",
    "tauri:preview:fast": "src-tauri\\target\\release\\open-clipper.exe",
    "tauri:build:preview": "npm run tauri:build && npm run tauri:preview",
    "tauri:build:preview:fast": "npm run tauri:build:fast && npm run tauri:preview:fast",
    "sherpa:directml": "powershell -ExecutionPolicy Bypass -File scripts/models/build-sherpa-directml.ps1",
    "models:manifest": "python models_automation\\models_manager.py manifest",
    "models:prepare": "python models_automation\\models_manager.py prepare",
    "models:verify": "python models_automation\\models_manager.py verify",
    "models:promote": "python models_automation\\models_manager.py promote",
    "models:rollback": "python models_automation\\models_manager.py rollback",
    "models:status": "python models_automation\\models_manager.py status"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.24.2",
    "@emotion/react": "^11.14.0",
    "@fontsource/inter": "^5.2.8",
    "@mediabunny/mp3-encoder": "1.50.8",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-tflite": "0.0.1-alpha.10",
    "axios": "^1.11.0",
    "framer-motion": "^12.23.24",
    "idb": "^8.0.3",
    "immer": "^10.1.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.539.0",
    "mediabunny": "1.50.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.1",
    "react-textarea-autosize": "^8.5.9",
    "uuid": "^11.1.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
