{
  "name": "open-clipper",
  "private": true,
  "version": "26.8.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "cross-env VITE_APP_PLATFORM=tauri vite",
    "build": "npm run build:web",
    "build:web": "vite build && node scripts/prune-web-models.mjs",
    "build:tauri": "cross-env VITE_APP_PLATFORM=tauri vite build && node scripts/prune-tauri-dist.mjs",
    "lint": "eslint src",
    "test": "vitest run src/features/clipper/persistence/clipper-export-social.util.spec.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "tauri:build:fast": "cross-env CARGO_TARGET_DIR=target-fast CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 CARGO_PROFILE_RELEASE_LTO=off CARGO_PROFILE_RELEASE_INCREMENTAL=true CARGO_PROFILE_RELEASE_OPT_LEVEL=2 CARGO_PROFILE_RELEASE_STRIP=none node scripts/run-tauri.mjs build --no-bundle",
    "tauri:preview": "node scripts/run-preview.mjs release",
    "tauri:preview:fast": "node scripts/run-preview.mjs fast",
    "tauri:build:preview": "npm run tauri:build && npm run tauri:preview",
    "tauri:build:preview:fast": "npm run tauri:build:fast && npm run tauri:preview:fast",
    "sherpa:directml": "powershell -ExecutionPolicy Bypass -File scripts/models/build-sherpa-directml.ps1",
    "models:manifest": "python models_automation\\models_manager.py manifest",
    "models:prepare": "python models_automation\\models_manager.py prepare",
    "models:verify": "python models_automation\\models_manager.py verify",
    "models:promote": "python models_automation\\models_manager.py promote",
    "models:rollback": "python models_automation\\models_manager.py rollback",
    "models:status": "python models_automation\\models_manager.py status",
    "release:prepare": "python release_automation\\release_manager.py prepare",
    "release:verify-build": "python release_automation\\release_manager.py verify-build",
    "release:promote": "python release_automation\\release_manager.py promote --base-url https://updates.openclipper.grepcut.com --notes \"Open Clipper desktop release\"",
    "release:desktop": "npm run release:prepare && npm run tauri:build && npm run release:verify-build",
    "release:clean-install": "powershell -ExecutionPolicy Bypass -File release_automation\\clean-install.ps1"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.24.2",
    "@emotion/react": "^11.14.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@mediabunny/mp3-encoder": "1.50.8",
    "@sentry/react": "^10.69.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.11.0",
    "eventsource-parser": "^3.0.6",
    "framer-motion": "^12.23.24",
    "idb": "^8.0.3",
    "immer": "^10.1.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.539.0",
    "mediabunny": "1.50.8",
    "p-limit": "^6.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.18.1",
    "react-textarea-autosize": "^8.5.9",
    "react-virtuoso": "^4.18.11",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
